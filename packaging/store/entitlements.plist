<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Droits du binaire principal de la version Mac App Store (ADR-0013, étape 7). Source : variante « main-no-ume » du
         spike (packaging/store-spike/entitlements), mesurée sans allow-unsigned-executable-memory.
         Volontairement ABSENTS : network.client (aucun réseau, spike 2026-10-28), inherit (aucun exécutable auxiliaire :
         la relance de l'exécutable principal fonctionne), files.downloads / bibliothèques tierces. -->
    <key>com.apple.security.app-sandbox</key><true/>
    <key>com.apple.security.files.user-selected.read-write</key><true/>
    <key>com.apple.security.files.bookmarks.app-scope</key><true/>
    <key>com.apple.security.device.audio-input</key><true/>
</dict>
</plist>
